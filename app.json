{
  "expo": {
    "name": "Forever",
    "slug": "forever",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "forever",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.demo.forever"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      ["react-native-ble-plx", { "isBackgroundEnabled": false }],
      [
        "expo-image-picker",
        { "photosPermission": "Allow $(PRODUCT_NAME) to access your photo library to attach images." }
      ],
      [
        "react-native-nfc-manager",
        { "nfcPermission": "Allow $(PRODUCT_NAME) to scan the NFC tag on your measurement device." }
      ]
    ]
  }
}
